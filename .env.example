PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@kodexcloud.local
ADMIN_PASSWORD=change-this-password
# Optional AI provider (never expose these values in browser code)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional GitHub OAuth / webhook configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional S3-compatible object storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional additional model providers (six model backends)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# KODEX-branded background AI worker default provider

# KODEX-owned local inference endpoint (Ollama-compatible). Run this model server beside your app.
KODEX_LOCAL_BASE_URL=http://127.0.0.1:11434
KODEX_LOCAL_MODEL=qwen2.5-coder:7b
KODEX_DEFAULT_AI_PROVIDER=kodex-local
